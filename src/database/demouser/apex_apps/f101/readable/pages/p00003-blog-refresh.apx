    region maintenance (
        name: Maintain Blog Posts
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Check WordPress for new or changed posts, then refresh the suggested posts to update their search chunks.</p>
                <p>Unknown posts need one refresh to establish their indexing baseline. Posts missing from WordPress are retained for review.</p>
                <p>Background Jobs updates every five seconds. Use Reload reports to update all counts. Source dates are shown in UTC.</p>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P3_ACTION (
        type: hidden
        layout {
            sequence: 10
            region: @maintenance
            slot: regionBody
        }
        security {
            sessionStateProtection: restricted
        }
    )

    button check-updates (
        buttonName: CHECK_UPDATES
        label: Check for updates
        layout {
            sequence: 10
            region: @maintenance
            slot: next
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            executeValidations: false
            showProcessing: true
        }
    )

    button refresh-suggested (
        buttonName: REFRESH_SUGGESTED
        label: Refresh suggested posts
        layout {
            sequence: 20
            region: @maintenance
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
        behavior {
            executeValidations: false
            showProcessing: true
        }
    )

    button reload-reports (
        buttonName: RELOAD_REPORTS
        label: Reload reports
        layout {
            sequence: 30
            region: @maintenance
            slot: next
        }
        appearance {
            buttonTemplate: @/text
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
            }
        }
    )

    process blog-maintenance (
        name: Blog Maintenance
        type: executionChain
        backgroundExecution {
            runInBackground: true
            executionsLimit: 1
        }
        serialization {
            serialize: true
            whenAlreadyRunning: error
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Blog maintenance submitted. Follow its progress in Background Jobs.
        }
        advanced {
            executionMappingIdentifier: 10549844963246637
        }
        serverSideCondition {
            type: expression
            language: javaScript-mle
            javaScriptExpression: "[\"CHECK_UPDATES\", \"REFRESH_SUGGESTED\"].includes(apex.env.REQUEST)"
        }
    )

    process prepare-maintenance (
        name: Prepare Blog Maintenance
        type: executeCode
        source {
            language: javaScript-mle
            javaScriptCode:
                ```javascript-mle
                const action = apex.env.REQUEST;
                apex.env.P3_ACTION = ["CHECK_UPDATES", "REFRESH_SUGGESTED"].includes(action) ? action : null;
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10549739879246637
        }
    )

    process run-maintenance (
        name: Check or Refresh Blog Posts
        type: executeCode
        executionChain: @blog-maintenance
        source {
            language: javaScript-mle
            javaScriptCode:
                ```javascript-mle
                (async () => {
                    const background = plsffi.resolvePackage("APEX_BACKGROUND_PROCESS");
                    const logger = plsffi.resolvePackage("LOGGER.LOGGER");
                    const logScope = "semantic_search.apex.blog_refresh";
                    try {
                        logger.log_info({
                            p_text: "Starting background blog maintenance",
                            p_scope: logScope,
                            p_extra: "action: " + apex.env.P3_ACTION
                        });
                        const blogPosts = await import("blog_posts");
                        const options = {
                            onProgress({ message, sofar, total }) {
                                background.set_status({ p_message: message });
                                background.set_progress({ p_sofar: sofar, p_totalwork: Math.max(total, 1) });
                            }
                        };
                        if (apex.env.P3_ACTION === "CHECK_UPDATES") {
                            await blogPosts.checkForUpdates(options);
                        } else if (apex.env.P3_ACTION === "REFRESH_SUGGESTED") {
                            await blogPosts.refreshSuggestedPosts(options);
                        } else {
                            throw new Error("Unsupported blog maintenance operation");
                        }
                        logger.log_info({
                            p_text: "Committing background blog maintenance",
                            p_scope: logScope,
                            p_extra: "action: " + apex.env.P3_ACTION
                        });
                        apex.conn.execute("commit");
                    } catch (error) {
                        logger.log_error({
                            p_text: "Background blog maintenance failed: " + String(error.message || error).slice(0, 1000),
                            p_scope: logScope,
                            p_extra: "action: " + apex.env.P3_ACTION + "\n" + String(error.stack || "")
                        });
                        apex.conn.execute("rollback");
                        background.set_status({
                            p_message: "Maintenance failed: " + String(error.message || error).slice(0, 1000)
                        });
                        throw error;
                    }
                })();
                ```
        }
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 10549914906246638
        }
    )

    branch (
        name: Return to Blog Refresh
        execution {
            sequence: 10
        }
        behavior {
            target: {
                page: 3
            }
        }
    )

)

