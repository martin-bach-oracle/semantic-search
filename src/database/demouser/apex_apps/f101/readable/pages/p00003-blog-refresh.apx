page 3 (
    name: Blog Refresh
    alias: BLOG-REFRESH
    title: Blog Refresh
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // Poll job progress; refresh the data reports when a job reaches a final state.
            let activeJobSeen = false;
            let refreshing = false;
            apex.jQuery("#blog-refresh-jobs").on("apexafterrefresh", function () {
                const active = this.querySelector(".blog-job-active");
                if (activeJobSeen && !active) {
                    apex.region("blog-refresh-summary").refresh();
                    apex.region("blog-refresh-posts").refresh();
                }
                activeJobSeen = Boolean(active);
                refreshing = false;
            });
            window.setInterval(function () {
                if (document.visibilityState === "visible" && !refreshing) {
                    refreshing = true;
                    apex.region("blog-refresh-jobs").refresh();
                }
            }, 5000);
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region blog-refresh-jobs (
        name: Background Jobs
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select execution_id, status_code, status_message,
                       case when totalwork > 0 then round(100 * sofar / totalwork) end progress_percent,
                       case when status_code in ('ENQUEUED', 'SCHEDULED', 'EXECUTING')
                         then 'blog-job-active' else 'blog-job-finished' end active_class
                from apex_appl_page_bg_proc_status
                where application_id = :APP_ID
                  and page_id = 3
                  and process_name = 'Blog Maintenance'
                order by execution_id desc
                fetch first 5 rows only
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        advanced {
            htmlDomId: blog-refresh-jobs
        }
        reportLayout {
            numberOfRows: 5
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--altRowsDefault
                t-Report--rowHighlight
            ]
        }
        pagination {
            type: rowRangesXToYOfZWithPagination
        }
        messages {
            whenNoDataFound: No records to display.
        }

        column ACTIVE_CLASS (
            reportColumnQueryId: 5
            derivedColumn: N
            type: hidden
            layout {
                sequence: 50
            }
        )

        column EXECUTION_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            heading {
                heading: Execution
            }
            layout {
                sequence: 10
            }
        )

        column PROGRESS_PERCENT (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Progress (%)
            }
            layout {
                sequence: 40
            }
        )

        column STATUS_CODE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Status
            }
            layout {
                sequence: 20
            }
            columnFormatting {
                htmlExpression: <span class="#ACTIVE_CLASS#">#STATUS_CODE#</span>
            }
        )

        column STATUS_MESSAGE (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Progress / Outcome
            }
            layout {
                sequence: 30
            }
        )

    )

